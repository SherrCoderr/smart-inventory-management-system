# ==============================================================================
# Smart Inventory Management System - Environment Configuration Template
# Copy this file to .env for local development or set these variables in Render.
# ==============================================================================

# Server Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (PostgreSQL / Neon)
# Local: jdbc:postgresql://localhost:5432/smart_inventory_db
# Neon Cloud: jdbc:postgresql://ep-example.region.aws.neon.tech/neondb?sslmode=require
DB_URL=jdbc:postgresql://localhost:5432/smart_inventory_db
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password_here
HIBERNATE_DDL_AUTO=update
SHOW_SQL=false

# Connection Pool Settings (Optimized for Serverless Neon)
HIKARI_MAX_POOL_SIZE=10
HIKARI_MIN_IDLE=2
HIKARI_MAX_LIFETIME=600000

# CORS Configuration (Comma-separated allowed origins)
# For production: include your Vercel frontend URL, e.g.:
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://smart-inventory-app.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Redis / Upstash Cache Configuration
CACHE_TYPE=redis
# Option 1: Full Redis URL (Upstash provides this directly)
# REDIS_URL=rediss://default:password@endpoint.upstash.io:6379
# Option 2: Individual Connection Parameters
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false

# JWT Security
# Generate a strong 256-bit Hex secret for production (e.g. openssl rand -hex 32)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Demo Data Seeder (Portfolio Presentation)
# Set to 'true' in Render to automatically populate realistic demo inventory, users, and transactions
DEMO_DATA_ENABLED=false

